{
  "name": "@intellmeet/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "IntellMeet API - Express 5 + Socket.io (deployed on Render)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@intellmeet/shared": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mongoose": "^8.24.4",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
