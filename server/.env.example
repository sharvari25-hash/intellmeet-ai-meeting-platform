# ---------------------------------------------------------------------------
# IntellMeet server environment
# Copy to `server/.env` and fill in. NEVER commit the real .env file.
# Every variable is validated by zod at startup (src/config/env.ts):
# a missing or malformed value stops the process with a readable message.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Render injects its own PORT in production.
PORT=5000

# Comma-separated list of browser origins allowed to call the API (CORS).
# In production this is the Vercel domain, set in render.yaml:
# https://intellmeet-ai-meeting-platform-clie.vercel.app
# Requests with no Origin header (curl, health checks) are always allowed.
CORS_ORIGINS=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Required (the server refuses to start without these) ------------------

# Local: mongodb://localhost:27017/intellmeet  (see docker-compose.yml)
# Prod : MongoDB Atlas M0 SRV connection string
MONGODB_URI=mongodb://localhost:27017/intellmeet

# Local: redis://localhost:6379  (see docker-compose.yml)
# Prod : Render Key Value's internal URL, wired by render.yaml (fromService),
#        e.g. redis://red-<id>:6379 on Render's private network.
# A rediss:// scheme (a Redis reached over the internet) enables TLS.
REDIS_URL=redis://localhost:6379

# --- Optional --------------------------------------------------------------

# How long graceful shutdown waits for in-flight requests before forcing
# sockets closed. Render sends SIGTERM and hard-kills roughly 30s later.
SHUTDOWN_TIMEOUT_MS=10000

# --- Auth (required) -------------------------------------------------------

# Signs access tokens. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-64-char-random-hex-string-see-command-above

# Access-token lifetime in seconds (default 900 = 15 minutes).
ACCESS_TOKEN_TTL_SEC=900

# Refresh-token lifetime in days, i.e. the maximum idle session length.
REFRESH_TOKEN_TTL_DAYS=7

# How long after a refresh token is rotated a replay still counts as a
# concurrent refresh rather than theft. Two browser tabs each refresh in their
# own JavaScript context and will race, so without a window a second tab looks
# exactly like a stolen token. Set to 0 to disable.
REFRESH_REUSE_GRACE_MS=10000

# Maximum refresh tokens retained per account; oldest are pruned first.
# Bounds document growth on heavily shared accounts such as the demo user.
MAX_SESSIONS_PER_USER=20

# bcrypt work factor. 12 here; production on Render sets 10 (render.yaml:
# cost 12 took 5-7 s per sign-in on the free plan's 0.1 CPU). Seed a
# database with the cost it will run with. The test suite uses 4.
BCRYPT_COST=12

# The seeded "Demo User" persona that owns the demo team and hosts the sample
# meetings. Created by `npm run seed -w @intellmeet/server`. POST /api/auth/demo
# ("Try Live Demo") does not sign in as it: every demo sign-in gets its own
# temporary guest account, added to the seeded demo team as a member.
DEMO_EMAIL=demo@intellmeet.app

# --- Demo-day tuning ------------------------------------------------------
# Everything from here to LIVE_MEETING_IDLE_MIN is safe to change on Render
# without a code change (README: "Demo-day tuning"). The defaults are sized
# for a room of judges sharing one network.

# The server sweeps demo data older than this: teams and meetings created in
# the demo workspace, and guest accounts that have been inactive (no sign-in or
# token refresh) for this long, together with what they created. The seeded
# team and its sample meetings are never removed, and nothing recent is, so
# nobody is swept out mid-demo.
DEMO_DATA_TTL_HOURS=6
DEMO_CLEANUP_INTERVAL_MIN=30

# Most guest accounts that may exist at once. "Try Live Demo" is public and
# creates an account, so this caps what a script could create; at the ceiling
# new demo sign-ins get a 503 until the sweep has removed inactive guests.
DEMO_MAX_GUESTS=200

# The seeded demo board's sample tasks go back where the seed put them once
# the board has been quiet (nothing created, changed or moved) for this many
# minutes. Reviewers share the board; this tidies it for the next one without
# ever resetting a board somebody is using.
DEMO_BOARD_RESET_IDLE_MIN=60

# Per-IP rate limits that a room of reviewers behind one college or office
# NAT shares. Every page load refreshes the session once, and every open tab
# once more each 15 minutes; each reviewer makes one or two demo sign-ins.
RATE_LIMIT_DEMO_PER_15_MIN=60
RATE_LIMIT_REFRESH_PER_15_MIN=600

# Register and password sign-in per IP per 15 minutes (each hashes a
# password; each reviewer signs in as a seeded team-mate for a second window),
# and failed sign-ins per IP and email. Production raises them to 60 and 10
# (render.yaml). Failed sign-ins are also capped at 30 per account per 15
# minutes whatever the address; that one is fixed.
RATE_LIMIT_AUTH_PER_15_MIN=30
RATE_LIMIT_LOGIN_FAILURES_PER_15_MIN=5

# A live meeting nobody has been connected to for this many minutes is ended
# automatically (closed tab, crash or restart, nobody pressed End). Checked
# every 5 minutes, so at the default it ends 10-15 minutes after the room
# empties.
LIVE_MEETING_IDLE_MIN=10

# Base URL of the web client, used to build shareable invite links.
CLIENT_URL=http://localhost:5173

# --- Cloudinary (optional) -------------------------------------------------
# Leave blank until you have an account. The app runs fine without them:
# GET /api/uploads/signature reports SERVICE_UNAVAILABLE, and meeting
# recordings are uploaded to the API and kept on local disk (RECORDINGS_DIR)
# instead of going to Cloudinary. Production should set them - Render's disk
# does not survive a deploy.
# All three are required together - a partial set counts as unconfigured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- WebRTC ICE servers ----------------------------------------------------

# Comma-separated STUN servers. Google's are free and public; STUN only reveals
# a peer's own public address, so there is no credential and no bandwidth cost.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relay (e.g. Metered's free tier). Optional, but calls behind symmetric
# NATs and strict corporate firewalls will fail without it. All three are
# required together; the credential is served per call and never bundled.
# Production uses Metered: the URLs are in render.yaml, the username and
# credential are set on Render (docs/deployment.md).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Recording + AI meeting intelligence (Phase 6) --------------------------

# Which AI provider transcribes and summarises recordings:
#   mock   - no account needed; deterministic output (default, used in tests
#            and by the e2e suite)
#   gemini - Google Gemini for both steps (the production provider)
#   groq   - Whisper for speech + Llama for the summary
# With AI_PROVIDER=groq and GEMINI_API_KEY also set, Gemini becomes the
# automatic fallback when a Groq call fails. The server refuses to start if the
# selected provider's key is missing.
AI_PROVIDER=mock

# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# A current free-tier Flash model that takes audio. Not the newest: at Phase
# 11 the two newest Flash models answered "high demand" (503) to free-tier
# keys for minutes at a time. The 2.5 family is now limited to projects that
# already used it. Check your quota at https://aistudio.google.com/rate-limit
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when GEMINI_MODEL still fails after one quick retry
# (overloaded, out of its daily quota, retired). The free tier allows 20
# requests a day PER MODEL (failed ones count), and a recorded meeting takes at
# least 2, so each model here adds ~10 meetings a day. `none` disables it.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash

# https://console.groq.com/keys  (free tier)
GROQ_API_KEY=
GROQ_TRANSCRIBE_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Largest audio file sent to the provider in one request, in MB (Groq's free
# tier caps uploads at 25 MB). Bigger recordings are split with ffmpeg into
# AI_CHUNK_SECONDS-long chunks first.
AI_MAX_FILE_MB=24
AI_CHUNK_SECONDS=600

# Attempts per recording, with exponential backoff starting at this delay.
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=10000

# Run the BullMQ worker inside the web process. Render's free tier has no
# background workers, so production keeps this true. Set false only when a
# separate `npm run worker` process consumes the queue.
RUN_WORKER_IN_PROCESS=true

# Without Cloudinary, recordings are uploaded to the API and stored here
# (relative to server/). Fine locally; Render's disk is wiped on every deploy,
# so production should set the Cloudinary variables above instead.
RECORDINGS_DIR=.data/recordings
MAX_RECORDING_MB=50

# Optional: use a system ffmpeg instead of the bundled one.
FFMPEG_PATH=
