# ---------------------------------------------------------------------------
# IntellMeet server environment
# Copy to `server/.env` and fill in. NEVER commit the real .env file.
# Every variable is validated by zod at startup (src/config/env.ts):
# a missing or malformed value stops the process with a readable message.
# ---------------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Port the HTTP server binds to. Render injects its own PORT in production.
PORT=5000

# Comma-separated list of browser origins allowed to call the API (CORS).
# In production this is the Vercel domain, e.g. https://intellmeet.vercel.app
# Requests with no Origin header (curl, health checks) are always allowed.
CORS_ORIGINS=http://localhost:5173

# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# --- Required (the server refuses to start without these) ------------------

# Local: mongodb://localhost:27017/intellmeet  (see docker-compose.yml)
# Prod : MongoDB Atlas M0 SRV connection string
MONGODB_URI=mongodb://localhost:27017/intellmeet

# Local: redis://localhost:6379  (see docker-compose.yml)
# Prod : Upstash TLS URL, e.g. rediss://default:<password>@<host>:6379
# A rediss:// scheme automatically enables TLS.
REDIS_URL=redis://localhost:6379

# --- Optional --------------------------------------------------------------

# How long graceful shutdown waits for in-flight requests before forcing
# sockets closed. Render sends SIGTERM and hard-kills roughly 30s later.
SHUTDOWN_TIMEOUT_MS=10000
