# ---------------------------------------------------------------------------
# IntellMeet client environment
# Copy to `client/.env`. Only variables prefixed with VITE_ reach the browser.
# WARNING: everything here is PUBLIC - never put a secret in this file.
# ---------------------------------------------------------------------------

# Socket.io endpoint. Must point straight at the Render service, because
# Vercel rewrites cannot proxy WebSocket upgrades.
# Local: http://localhost:5000   Prod: https://<service>.onrender.com
VITE_SOCKET_URL=http://localhost:5000

# Optional: override the dev-only /api proxy target used by vite.config.ts.
# REST always goes through a same-origin /api path, so there is no API base URL.
VITE_DEV_API_PROXY=http://localhost:5000

# --- Added in later phases -------------------------------------------------
# VITE_SENTRY_DSN=
