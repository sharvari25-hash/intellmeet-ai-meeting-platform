# nginx for the client image. Rendered at container start by the image's
# entrypoint: ${API_UPSTREAM} is substituted (and only that, see
# NGINX_ENVSUBST_FILTER in client/Dockerfile); nginx's own variables are kept.
#
# One origin for everything, like production:
#   /api/*        -> the API   (Vercel does this with a rewrite)
#   /socket.io/*  -> the API   (production connects to Render directly)
#   everything else -> the single-page app, with index.html as the fallback

# WebSocket upgrades need "Connection: upgrade"; a plain long-polling request
# must not be sent one.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;

    # Inherited by every location below that sets no add_header of its own.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # For the container's healthcheck and the Kubernetes probes.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A recording upload without Cloudinary goes through here
        # (MAX_RECORDING_MB is 50).
        client_max_body_size 60m;
        proxy_read_timeout 120s;
    }

    location /socket.io/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # A socket can stay quiet between Socket.io's pings; an hour keeps a
        # meeting connected without holding dead connections forever.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Vite puts a content hash in every asset name, so they never change.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    # The app shell must always be revalidated, or a deploy is invisible until
    # the cache expires.
    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
